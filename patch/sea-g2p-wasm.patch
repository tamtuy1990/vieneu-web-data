@@ -231,3 +231,32 @@
 pub extern "C" fn sea_g2p_abi_version() -> i32 {
     1
 }
+
+// ── wasm32: cấp/giải phóng bộ nhớ cho JS và giao từ điển dạng byte ─────────────
+#[cfg(target_arch = "wasm32")]
+#[no_mangle]
+pub extern "C" fn sea_g2p_alloc(n: usize) -> *mut u8 {
+    let mut v = Vec::<u8>::with_capacity(n.max(1));
+    let p = v.as_mut_ptr();
+    std::mem::forget(v);
+    p
+}
+
+/// # Safety
+/// `ptr`/`n` must come from one [`sea_g2p_alloc`] call.
+#[cfg(target_arch = "wasm32")]
+#[no_mangle]
+pub unsafe extern "C" fn sea_g2p_free(ptr: *mut u8, n: usize) {
+    if !ptr.is_null() { drop(unsafe { Vec::from_raw_parts(ptr, 0, n.max(1)) }); }
+}
+
+/// Giao toàn bộ `sea_g2p.bin` (đã chép vào vùng nhớ từ [`sea_g2p_alloc`], không bao giờ giải phóng). Trả 1 nếu nhận.
+///
+/// # Safety
+/// `ptr..ptr+n` must hold the dictionary bytes and stay alive for the program's lifetime.
+#[cfg(target_arch = "wasm32")]
+#[no_mangle]
+pub unsafe extern "C" fn sea_g2p_set_dict(ptr: *const u8, n: usize) -> i32 {
+    let bytes: &'static [u8] = unsafe { std::slice::from_raw_parts(ptr, n) };
+    crate::core::dict::WASM_DICT.set(bytes).is_ok() as i32
+}
